# Local: copie para .env e preencha. NUNCA suba o .env para o git.
# Na Vercel: basta cadastrar PROFANUS_API_KEY em Project > Settings > Environment Variables.

# --- OBRIGATÓRIA ---
# Chave da API da Profanus Pay (profanus_live_...). Só no servidor / Vercel, nunca no front.
PROFANUS_API_KEY=

# --- Opcionais ---
PORT=3000
# URL pública (só necessária em domínio próprio; na Vercel é detectada sozinha)
PUBLIC_URL=http://localhost:3000
# Avisos do formulário de contato por e-mail (Resend). Sem isso, as mensagens aparecem nos Logs da Vercel.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
